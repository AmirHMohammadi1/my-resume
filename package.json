{
  "name": "new-resume",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual (fa/en) static resume & portfolio — Next.js, deployed to GitHub Pages",
  "scripts": {
    "sync": "node scripts/sync-blog.mjs",
    "dev": "node scripts/sync-blog.mjs && next dev",
    "build": "node scripts/sync-blog.mjs && next build && node scripts/postbuild.mjs",
    "serve": "npx serve out",
    "typecheck": "node scripts/sync-blog.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/space-grotesk": "^5.1.0",
    "@fontsource-variable/vazirmatn": "^5.1.0",
    "marked": "^14.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
